    res = run_candidate_tests(ROOT_DIR)
    assert res.returncode == 0, (
        f"A suíte de testes do candidato falhou ao rodar contra o módulo original correto!\n"
        f"Stdout:\n{res.stdout}\nStderr:\n{res.stderr}"
    )


def executar_mutante(nome_mutante: str):
    mutante_file = MUTANTES_DIR / f"{nome_mutante}.py"
    assert mutante_file.is_file(), f"Arquivo do mutante não encontrado: {mutante_file}"

    with tempfile.TemporaryDirectory() as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        # Copia o mutante como validador.py
        shutil.copyfile(mutante_file, temp_dir / "validador.py")
        # Copia a pasta tests do candidato
        shutil.copytree(ROOT_DIR / "tests", temp_dir / "tests")

        res = run_candidate_tests(temp_dir)
        # O mutante é considerado morto/eliminado se a suíte de testes FALHAR nele
        assert res.returncode != 0, (
