+def oraculo_bruto(dados, alvo):
+    maior = 0
+    for inicio in range(len(dados)):
+        soma = 0
+        for fim in range(inicio, len(dados)):
+            soma += dados[fim]
+            if soma == alvo:
+                maior = max(maior, fim - inicio + 1)
+    return maior
