import random
import time
import pytest
from otimizador import maior_subarray_soma


def test_lista_vazia():
    assert maior_subarray_soma([], 0) == 0
    assert maior_subarray_soma([], 10) == 0


def test_alvo_inexistente():
    assert maior_subarray_soma([1, 2, 3, 4], 20) == 0


def test_elemento_unico():
    assert maior_subarray_soma([5], 5) == 1
    assert maior_subarray_soma([5], 3) == 0


def test_exemplo_enunciado():
    assert maior_subarray_soma([1, -1, 5, -2, 3], 3) == 4


def test_negativos_e_positivos():
    assert maior_subarray_soma([-2, -1, 2, 1], 1) == 2


def test_todos_zeros():
    # Qualquer subarray de zeros soma 0. O maior é a lista inteira (tamanho 5).
    assert maior_subarray_soma([0, 0, 0, 0, 0], 0) == 5


def test_multiplos_subarrays_pega_o_maior():
    # [3, 1, -1, 1, -1, 1] com alvo 3
    # Subarrays com soma 3:
    # [3] (len 1)
    # [3, 1, -1] (len 3)
    # [3, 1, -1, 1, -1] (len 5)
    # Deve retornar 5
    assert maior_subarray_soma([3, 1, -1, 1, -1, 1], 3) == 5


def test_lista_inteira_soma_alvo():
    nums = [10, 20, 30, 40]
    assert maior_subarray_soma(nums, 100) == 4


def test_performance_entrada_grande():
    # Gera 250.000 números inteiros com determinismo
    rng = random.Random(42)
    # Alterna números entre -5 e 5
    tamanho = 250_000
    dados = [rng.randint(-5, 5) for _ in range(tamanho)]
    alvo = 42

    inicio = time.perf_counter()
    res = maior_subarray_soma(dados, alvo)
    duracao = time.perf_counter() - inicio

    assert isinstance(res, int)
    assert res > 0
    # Deve executar com folga em menos de 1.5 segundo
    assert duracao < 1.5, f"Algoritmo muito lento: levou {duracao:.3f}s (limite: 1.5s)"


===== tarefas/08-testes-gemini/enunciado.md =====
# 08 - Elaboração de Suíte de Testes Unitários

Você recebeu o módulo correto `validador.py` contendo a implementação da classe `ValidadorSenha` e a constante `CARACTERES_ESPECIAIS_PERMITIDOS`.

Sua tarefa é escrever uma suíte de testes unitários abrangente utilizando `pytest` no diretório `tests/` (por exemplo, no arquivo `tests/test_validador.py`).

## Avaliação por Testes de Mutação (Mutation Testing)

A avaliação da sua suíte será realizada por um executor automatizado que:
1. Executará os seus testes contra a implementação correta de `validador.py` (seus testes **devem passar com 100% de sucesso**).
2. Executará os seus testes contra **10 mutantes** (versões de `validador.py` contendo exatamente 1 bug sutil ou regra negligenciada).
3. Cada mutante é considerado **morto (eliminado)** se a sua suíte de testes **falhar** ao rodar contra ele. Se a sua suíte passar em um mutante com bug, o mutante terá sobrevivido e o teste correspondente será reprovado.

## Especificação do Módulo `validador.py`

### Constante
- `CARACTERES_ESPECIAIS_PERMITIDOS = set("!@#$%^&*()-_+=") `

### Classe `ValidadorSenha`
- `__init__(self, min_tam: int = 8, max_tam: int = 64) -> None`:
  Define os limites mínimo e máximo de caracteres.

- `validar(self, senha: str) -> tuple[bool, list[str]]`:
  Valida a string fornecida contra as regras:
  1. Comprimento mínimo: `len(senha) >= self.min_tam`. Se violado: adiciona erro.
  2. Comprimento máximo: `len(senha) <= self.max_tam`. Se violado: adiciona erro.
  3. Deve conter ao menos uma letra maiúscula (`c.isupper()`).
  4. Deve conter ao menos uma letra minúscula (`c.islower()`).
  5. Deve conter ao menos um dígito numérico (`c.isdigit()`).
  6. Deve conter ao menos um caractere especial pertencente a `CARACTERES_ESPECIAIS_PERMITIDOS`.
  7. **Não pode** conter espaços em branco (`c.isspace()`).
  8. **Não pode** conter 3 caracteres repetidos consecutivos (ex.: `"aaa"`, `"111"`).
  - Retorna `(True, [])` se todas as regras forem cumpridas, ou `(False, lista_de_mensagens_de_erro)` caso haja violações.

- `calcular_forca(self, senha: str) -> str`:
  - Se a senha for inválida perante `validar(senha)`: retorna `"invalida"`.
  - Se for válida e `len(senha) < 10`: retorna `"fraca"`.
  - Se for válida e `10 <= len(senha) < 14`: retorna `"media"`.
  - Se for válida e `len(senha) >= 14`: retorna `"forte"`.

## Arquivos a Entregar

Crie seus arquivos de teste dentro da pasta `tests/` na raiz do seu projeto (ex.: `tests/test_validador.py`).


