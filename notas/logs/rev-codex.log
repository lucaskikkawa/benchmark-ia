+            input=json.dumps([dados, alvo]), capture_output=True, text=True, timeout=15,
+        )
+    except subprocess.TimeoutExpired:
+        pytest.fail("A execução excedeu 15s, incluindo a inicialização do processo.")
+    assert execucao.returncode == 0, execucao.stdout + execucao.stderr
+    resultado, duracao = json.loads(metricas.read_text(encoding="utf-8"))
+    assert type(resultado) is int
+    assert resultado == esperado
+    assert duracao < 5.0, f"Algoritmo muito lento: levou {duracao:.3f}s (limite: 5s)"
diff --git a/tarefas/08-testes-gemini/enunciado.md b/tarefas/08-testes-gemini/enunciado.md
index ce9f8a47f483f0c2d16085c7a4e5181cefb5e344..5c3e2762969a085bb3ba7a6293faf9badf9b9eef
--- a/tarefas/08-testes-gemini/enunciado.md
+++ b/tarefas/08-testes-gemini/enunciado.md
@@ -9,7 +9,8 @@
 A avaliação da sua suíte será realizada por um executor automatizado que:
 1. Executará os seus testes contra a implementação correta de `validador.py` (seus testes **devem passar com 100% de sucesso**).
 2. Executará os seus testes contra **10 mutantes** (versões de `validador.py` contendo exatamente 1 bug sutil ou regra negligenciada).
-3. Cada mutante é considerado **morto (eliminado)** se a sua suíte de testes **falhar** ao rodar contra ele. Se a sua suíte passar em um mutante com bug, o mutante terá sobrevivido e o teste correspondente será reprovado.
+3. Cada mutante é considerado **morto (eliminado)** se a sua suíte apresentar **falha de teste** ao rodar contra ele (código de saída 1 do pytest). Erros de coleta, ausência de testes, interrupções e timeouts não eliminam mutantes. Se a sua suíte passar em um mutante com bug, o mutante terá sobrevivido e o teste correspondente será reprovado.
+4. Cada execução da suíte tem limite de **10 segundos**. A pasta `tests/` é copiada, com seus recursos e subpastas, para um diretório temporário junto com a versão avaliada de `validador.py`, tanto para o original quanto para os mutantes. Use a descoberta padrão do pytest; não é necessário que os arquivos estejam diretamente na raiz de `tests/`.
 
 ## Especificação do Módulo `validador.py`
 
