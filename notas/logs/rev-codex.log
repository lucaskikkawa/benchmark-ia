import pytest
from fake_api import FakeApiServer
from cliente_resiliente import ApiError, ClienteResiliente


class MockSleeper:
    def __init__(self):
        self.delays: list[float] = []

    def __call__(self, delay: float) -> None:
        self.delays.append(delay)


def test_sucesso_imediato_get_e_post():
    servidor = FakeApiServer()
    sleeper = MockSleeper()
    cliente = ClienteResiliente(servidor=servidor, sleep_fn=sleeper)

    res_get = cliente.get("/itens")
    assert res_get["status"] == "ok"
    assert res_get["metodo"] == "GET"

    res_post = cliente.post("/itens", {"nome": "Novo Item"})
    assert res_post["status"] == "ok"
    assert res_post["metodo"] == "POST"
    assert res_post["payload"] == {"nome": "Novo Item"}
    assert len(sleeper.delays) == 0


def test_recuperacao_apos_falha_de_rede():
    servidor = FakeApiServer()
    sleeper = MockSleeper()
    # 2 falhas de rede, na 3ª tem sucesso
    servidor.configurar_falhas("/dados", qtd_falhas=2, tipo_falha="network")
    cliente = ClienteResiliente(
        servidor=servidor,
        max_tentativas=3,
        backoff_base=0.1,
        backoff_fator=2.0,
        sleep_fn=sleeper,
    )

    dados = cliente.get("/dados")
    assert dados["status"] == "ok"
    assert len(servidor.chamadas) == 3
    # Delays calculados: tentativa 1 -> 0.1 * (2.0 ** 0) = 0.1; tentativa 2 -> 0.1 * (2.0 ** 1) = 0.2
    assert pytest.approx(sleeper.delays, 0.001) == [0.1, 0.2]


def test_recuperacao_apos_timeout_e_503():
    servidor = FakeApiServer()
    sleeper = MockSleeper()
    servidor.configurar_falhas("/processamento", qtd_falhas=1, tipo_falha="timeout")
    cliente = ClienteResiliente(servidor=servidor, max_tentativas=3, sleep_fn=sleeper)

    res = cliente.get("/processamento")
    assert res["status"] == "ok"
    assert len(servidor.chamadas) == 2
    assert len(sleeper.delays) == 1


def test_recuperacao_apos_rate_limit_429():
    servidor = FakeApiServer()
    sleeper = MockSleeper()
    servidor.configurar_falhas("/limitada", qtd_falhas=1, tipo_falha="429")
    cliente = ClienteResiliente(servidor=servidor, max_tentativas=2, sleep_fn=sleeper)

    res = cliente.get("/limitada")
    assert res["status"] == "ok"
    assert len(servidor.chamadas) == 2


def test_esgotamento_de_tentativas_lanca_apierror():
    servidor = FakeApiServer()
    sleeper = MockSleeper()
    # 5 falhas de rede configuradas, cliente tem limite de 3 tentativas
    servidor.configurar_falhas("/indisponivel", qtd_falhas=5, tipo_falha="network")
    cliente = ClienteResiliente(servidor=servidor, max_tentativas=3, sleep_fn=sleeper)

    with pytest.raises(ApiError) as exc_info:
        cliente.get("/indisponivel")

    assert len(servidor.chamadas) == 3
    assert len(sleeper.delays) == 2
    assert "Tentativas esgotadas" in str(exc_info.value)


def test_erro_404_sem_retry():
    servidor = FakeApiServer()
    sleeper = MockSleeper()
    servidor.configurar_resposta("/nao-existe", status_code=404, data={"erro": "Not Found"})
    cliente = ClienteResiliente(servidor=servidor, max_tentativas=3, sleep_fn=sleeper)

    with pytest.raises(ApiError) as exc_info:
        cliente.get("/nao-existe")

    # Erro 404 é não recuperável: deve falhar imediatamente na primeira tentativa
    assert len(servidor.chamadas) == 1
    assert len(sleeper.delays) == 0
    assert exc_info.value.status_code == 404


def test_erro_400_sem_retry():
    servidor = FakeApiServer()
    sleeper = MockSleeper()
    servidor.configurar_resposta("/bad-request", status_code=400, data={"erro": "Bad Request"})
    cliente = ClienteResiliente(servidor=servidor, max_tentativas=3, sleep_fn=sleeper)

    with pytest.raises(ApiError) as exc_info:
        cliente.post("/bad-request", {"invalido": True})

    assert len(servidor.chamadas) == 1
    assert len(sleeper.delays) == 0
    assert exc_info.value.status_code == 400


def test_timeout_passado_ao_servidor():
    servidor = FakeApiServer()
    cliente = ClienteResiliente(servidor=servidor, timeout=4.5)
    cliente.get("/ping")
    assert servidor.chamadas[0]["timeout"] == 4.5


def test_max_tentativas_invalido():
    servidor = FakeApiServer()
    with pytest.raises(ValueError):
        ClienteResiliente(servidor=servidor, max_tentativas=0)


===== tarefas/10-ambigua-gemini/enunciado.md =====
# 10 - Classificação de Clientes e Score de Fidelidade (Especificação com Pontos Abertos)

Implemente a função `classificar_cliente` no arquivo `solucao.py` na raiz do seu diretório de trabalho.

## Assinatura

```python
def classificar_cliente(dados: dict) -> dict:
    ...
```

## Núcleo Explícito Obrigatório

O dicionário `dados` de entrada possui as seguintes informações sobre o cliente:
- `id` (str): identificador único do cliente.
- `nome` (str): nome do cliente.
- `compras` (list[float | int]): histórico de valores de compras realizadas.
- `anos_ativo` (int): número de anos em que o cliente é usuário ativo.

### Regras Inequívocas de Cálculo do Score:
1. O score base de compras corresponde a **10% da soma dos valores das compras** (`soma_compras * 0.1`).
2. O score de fidelidade concede **5 pontos por cada ano ativo** (`anos_ativo * 5`).
3. O score final é a soma do score base de compras com o score de fidelidade, devendo ser arredondado para 2 casas decimais (`round(..., 2)`).
4. O dicionário de retorno deve conter obrigatoriamente as chaves:
   - `"id"`: mesmo id de entrada.
   - `"nome"`: mesmo nome de entrada.
   - `"score"`: número (float ou int) correspondente ao score final calculado.
   - `"categoria"`: uma string não vazia representando o segmento/nível do cliente.

## Pontos Abertos e Arquivo `SUPOSICOES.md` (OBRIGATÓRIO)

Alguns aspectos do comportamento não foram fechados na especificação, tais como:
- Quais nomes de categorias atribuir e quais faixas/critérios de pontuação utilizar para categorizar o cliente.
- Como lidar com valores negativos na lista de compras (ex.: estornos/devoluções vs. ignorar).
- Como interpretar ou ajustar anos ativos negativos caso ocorram.
- Como tratar campos adicionais presentes na entrada.

Você **DEVE** criar um arquivo chamado `SUPOSICOES.md` na raiz do diretório de trabalho documentando detalhadamente suas decisões de design, critérios de categorização adotados e premissas assumidas.

> **Importante:** A suíte de testes automatizados valida exclusivamente o **núcleo explícito inequívoco** e a presença do arquivo `SUPOSICOES.md`. A qualidade e profundidade da sua documentação de suposições serão avaliadas pela rubrica qualitativa.


