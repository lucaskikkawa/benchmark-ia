from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import pytest

ROOT_DIR = Path(__file__).resolve().parent.parent
MUTANTES_DIR = Path(__file__).resolve().parent / "mutantes"


def run_candidate_tests(workdir: Path):
    cmd = [sys.executable, "-m", "pytest", "-q", "tests"]
    return subprocess.run(cmd, cwd=str(workdir), capture_output=True, text=True)


def test_suite_passa_no_modulo_original():
    tests_dir = ROOT_DIR / "tests"
    assert tests_dir.is_dir(), "Diretório 'tests/' não encontrado no diretório raiz da solução."
    arquivos_teste = list(tests_dir.glob("test_*.py"))
    assert len(arquivos_teste) > 0, "Nenhum arquivo 'test_*.py' encontrado dentro de 'tests/'."

    res = run_candidate_tests(ROOT_DIR)
    assert res.returncode == 0, (
        f"A suíte de testes do candidato falhou ao rodar contra o módulo original correto!\n"
        f"Stdout:\n{res.stdout}\nStderr:\n{res.stderr}"
    )


def executar_mutante(nome_mutante: str):
    mutante_file = MUTANTES_DIR / f"{nome_mutante}.py"
    assert mutante_file.is_file(), f"Arquivo do mutante não encontrado: {mutante_file}"

    with tempfile.TemporaryDirectory() as temp_dir_str:
        temp_dir = Path(temp_dir_str)
        # Copia o mutante como validador.py
        shutil.copyfile(mutante_file, temp_dir / "validador.py")
        # Copia a pasta tests do candidato
        shutil.copytree(ROOT_DIR / "tests", temp_dir / "tests")

        res = run_candidate_tests(temp_dir)
        # O mutante é considerado morto/eliminado se a suíte de testes FALHAR nele
        assert res.returncode != 0, (
            f"O mutante {nome_mutante} SOBREVIVEU! A suíte de testes deveria ter falhado nele, "
            f"mas retornou sucesso (código 0).\nStdout:\n{res.stdout}"
        )


