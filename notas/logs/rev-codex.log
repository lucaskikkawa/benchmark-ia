def test_multiplos_handlers_para_mesmo_topico():
    bus = EventBus()
    contador = {"chamadas": 0}

    def h1(ev):
        contador["chamadas"] += 1

    def h2(ev):
        contador["chamadas"] += 10

    bus.subscribe("notificacao", h1)
    bus.subscribe("notificacao", h2)

    bus.publish("notificacao", {"msg": "oi"})
    bus.dispatch_all()
    assert contador["chamadas"] == 11


