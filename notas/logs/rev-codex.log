def run_candidate_tests(workdir: Path):
    cmd = [sys.executable, "-m", "pytest", "-q", "tests"]
    return subprocess.run(cmd, cwd=str(workdir), capture_output=True, text=True)


def test_suite_passa_no_modulo_original():
