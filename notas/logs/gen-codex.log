"""Avaliação da suíte submetida em cópias independentes e sem rede."""
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import pytest

OCULTOS = Path(__file__).resolve().parent
TRABALHO = OCULTOS.parent
MUTANTES = sorted((OCULTOS / 'mutantes').glob('mutante_*.py'))


def executar_suite(modulo):
    testes = TRABALHO / 'tests'
    assert testes.is_dir(), 'Crie tests/test_*.py'
    assert any(testes.glob('test_*.py')), 'Nenhum arquivo tests/test_*.py encontrado'
    with tempfile.TemporaryDirectory(prefix='suite-carrinho-') as pasta:
        sandbox = Path(pasta)
        shutil.copytree(testes, sandbox / 'tests', ignore=shutil.ignore_patterns('__pycache__', '.pytest_cache'))
        shutil.copyfile(modulo, sandbox / 'carrinho.py')
        env = os.environ.copy()
        env['PYTHONPATH'] = str(sandbox)
        env['PYTEST_DISABLE_PLUGIN_AUTOLOAD'] = '1'
        env.pop('PYTEST_ADDOPTS', None)
        env.pop('PYTEST_PLUGINS', None)
        try:
            return subprocess.run([sys.executable, '-m', 'pytest', '-q', 'tests',
                                   '--tb=short', '-p', 'no:cacheprovider'],
                                  cwd=sandbox, env=env, capture_output=True, text=True, timeout=8)
        except subprocess.TimeoutExpired:
            pytest.fail('A suíte submetida excedeu 8 segundos por execução')


@pytest.fixture(scope='session')
def suite_valida():
    resultado = executar_suite(OCULTOS / 'suporte' / 'carrinho_correto.py')
    assert resultado.returncode == 0, ('A suíte deve passar no módulo correto.\n'
                                        + resultado.stdout + resultado.stderr)
    return resultado


def test_suite_passou_no_modulo_correto(suite_valida):
    assert suite_valida.returncode == 0


@pytest.mark.parametrize('mutante', MUTANTES, ids=lambda p: p.stem)
def test_mata_mutante(mutante, suite_valida):
    resultado = executar_suite(mutante)
    # Código 1 significa falha de teste; erro de coleta (2) ou ausência (5) não mata.
    assert resultado.returncode == 1, (f'{mutante.stem}: esperado teste falhar (código 1), '
                                      f'obtido {resultado.returncode}.\n'
                                      + resultado.stdout + resultado.stderr)
# Organizar tarefas pendentes

Crie `organizador.py` com:

```python
def organizar_tarefas(tarefas: list[dict]) -> list[dict]:
    ...
```

Queremos uma pequena organização de tarefas por prioridade. O núcleo obrigatório:
para entradas válidas, devolva SOMENTE tarefas com `concluida == False`, em ordem
decrescente de `prioridade` (número maior primeiro). Cada tarefa válida contém
`titulo` (str não vazia), `prioridade` (inteiro de 0 a 5) e `concluida` (bool).
Preserve os valores dos campos originais. Não altere a lista nem os dicionários
recebidos. Retorne uma nova lista com uma cópia rasa independente de cada
dicionário incluído. Não remova ocorrências repetidas; cada entrada pendente
representa uma tarefa. Entrada vazia ou só com concluídas retorna `[]`.

Há decisões em aberto: como desempatar prioridades? Como lidar com campos
extras? Como tratar entradas com campos ausentes, tipos errados ou prioridades
fora da faixa? Não é preciso perguntar: escolha políticas simples e registre-as
em `SUPOSICOES.md`, no diretório de trabalho. O documento é parte obrigatória da
entrega e precisa conter texto não vazio. Não há formato ou palavras obrigatórias.
Os testes verificam apenas o núcleo acima e a existência desse documento; não
impõem ordem entre empates nem comportamento para entradas fora do domínio.

Ambiente: Python 3.11, somente biblioteca padrão na solução; sem rede.

