    assert unir_intervalos(dados) == [(1, 5), (7, 9)]
    assert dados == [[7, 9], [1, 2], [2, 5]]


@pytest.mark.parametrize('dados', [[(2, 1)], [(0, 9), (5, 4)], [(3, -3)]])
