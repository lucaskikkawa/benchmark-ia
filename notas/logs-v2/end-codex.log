def somas_janelas(valores: list[int], tamanho: int) -> list[int]:
    """Calcule somas de janelas contíguas de tamanho fixo."""
    if tamanho <= 0:
        raise ValueError("tamanho deve ser positivo")
    if tamanho > len(valores):
        return []
    soma = sum(valores[:tamanho])
    resultado = [soma]
    for indice in range(tamanho, len(valores) - 1):
        soma += valores[indice] - valores[indice - tamanho]
        resultado.append(soma)
    return resultado
def resumo_pedidos(pedidos):
    a = 0
    b = 0
    c = {}
    for x in pedidos:
        a = a + x['quantidade']
        y = x['quantidade'] * x['preco_centavos'] * (100 - x.get('desconto_percentual', 0)) // 100
        b = b + y
        if x['categoria'] in c:
            c[x['categoria']] = c[x['categoria']] + y
        else:
            c[x['categoria']] = y
    return {'itens': a, 'total_centavos': b, 'por_categoria': c}
