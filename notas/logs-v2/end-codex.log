+
+
+def test_volume_precisao_filtro_apos_agregacao(tmp_path):
+    preco = 10**90 + 13
+    linhas = ['produto,quantidade,preco_centavos,status\n']
+    linhas.extend(f'P{i % 17:02d},3,{preco},pago\n' for i in range(30_000))
+    minimo = 1765 * 3 * preco
