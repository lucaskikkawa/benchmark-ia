import csv
import json
from collections import defaultdict
from pathlib import Path


def processar_vendas(
    caminho_csv: str,
    caminho_json_saida: str,
    status_filtro: str = "concluido",
    top_n: int = 3,
) -> dict:
    """Lê transações de um arquivo CSV, filtra, agrega métricas e salva em JSON."""
    if type(top_n) is not int:
        raise TypeError("O parâmetro top_n deve ser um inteiro.")
    if top_n < 1:
        raise ValueError("O parâmetro top_n deve ser pelo menos 1.")

    p_csv = Path(caminho_csv)
    if not p_csv.is_file():
        raise FileNotFoundError(f"Arquivo CSV não encontrado: {caminho_csv}")

    status_filtro_norm = str(status_filtro).strip().lower()

    transacoes_filtradas = []
    por_categoria = defaultdict(float)
    por_cliente = defaultdict(float)

    with open(p_csv, mode="r", encoding="utf-8-sig") as f:
        leitor = csv.DictReader(f)
        for linha in leitor:
            if not linha:
                continue
            status_linha = (linha.get("status") or "").strip().lower()
            if status_linha != status_filtro_norm:
                continue

            try:
                valor_raw = (linha.get("valor") or "").strip()
                valor = float(valor_raw)
                if valor < 0:
                    continue
            except (ValueError, TypeError):
                continue

            cliente = (linha.get("cliente") or "").strip()
            categoria = (linha.get("categoria") or "").strip()

            transacoes_filtradas.append(valor)
            por_categoria[categoria] += valor
            por_cliente[cliente] += valor

    total_transacoes = len(transacoes_filtradas)
    receita_total = round(sum(transacoes_filtradas), 2)
    ticket_medio = round(receita_total / total_transacoes, 2) if total_transacoes > 0 else 0.0

    dict_categorias = {
        cat: round(val, 2)
        for cat, val in sorted(por_categoria.items(), key=lambda x: x[0])
    }

    clientes_ordenados = sorted(
        por_cliente.items(),
        key=lambda item: (-round(item[1], 2), item[0]),
    )
    top_clientes = [
        {"cliente": nome, "total": round(val, 2)}
        for nome, val in clientes_ordenados[:top_n]
    ]

    resultado = {
        "total_transacoes": total_transacoes,
        "receita_total": receita_total,
        "ticket_medio": ticket_medio,
        "por_categoria": dict_categorias,
        "top_clientes": top_clientes,
    }

    p_saida = Path(caminho_json_saida)
    p_saida.parent.mkdir(parents=True, exist_ok=True)
    with open(p_saida, mode="w", encoding="utf-8") as f:
        json.dump(resultado, f, indent=2, ensure_ascii=False)

    return resultado
from dataclasses import dataclass, field
import random
from typing import Any


class SimulatedNetworkError(Exception):
    """Simula perda transitória de conexão de rede."""
    pass


class SimulatedTimeoutError(Exception):
    """Simula timeout da requisição."""
    pass


@dataclass
class ApiResponse:
    status_code: int
    data: dict
    headers: dict = field(default_factory=dict)


class FakeApiServer:
    """Servidor mock determinístico em processo."""

    def __init__(self, seed: int = 42) -> None:
        self.rng = random.Random(seed)
        self.chamadas: list[dict[str, Any]] = []
        self._falhas: dict[str, dict[str, Any]] = {}
        self._respostas: dict[str, ApiResponse] = {}

    def configurar_falhas(self, rota: str, qtd_falhas: int, tipo_falha: str = "network") -> None:
        """Configura quantidade e tipo de falha transitória antes de responder com sucesso."""
        self._falhas[rota] = {"qtd": qtd_falhas, "tipo": tipo_falha}

    def configurar_resposta(self, rota: str, status_code: int, data: dict) -> None:
        """Define a resposta padrão para uma rota."""
        self._respostas[rota] = ApiResponse(status_code=status_code, data=data)

    def requisicao(
        self,
        metodo: str,
        rota: str,
        payload: dict | None = None,
        timeout: float | None = None,
    ) -> ApiResponse:
        """Processa uma requisição simulada."""
        self.chamadas.append({
            "metodo": metodo,
            "rota": rota,
            "payload": payload,
            "timeout": timeout,
        })

        if rota in self._falhas:
            cfg = self._falhas[rota]
            if cfg["qtd"] > 0:
                cfg["qtd"] -= 1
                tipo = cfg["tipo"]
                if tipo == "network":
                    raise SimulatedNetworkError("Conexão interrompida com o servidor.")
                elif tipo == "timeout":
                    raise SimulatedTimeoutError("Operação excedeu o tempo limite configurado.")
                elif tipo == "503":
                    return ApiResponse(status_code=503, data={"erro": "Serviço Indisponível"})
                elif tipo == "429":
                    return ApiResponse(status_code=429, data={"erro": "Too Many Requests"})

        if rota in self._respostas:
            return self._respostas[rota]

        return ApiResponse(
            status_code=200,
            data={"status": "ok", "metodo": metodo, "rota": rota, "payload": payload},
        )
import time
from typing import Callable
from fake_api import (
    ApiResponse,
    FakeApiServer,
    SimulatedNetworkError,
    SimulatedTimeoutError,
)


class ApiError(Exception):
    """Exceção levantada quando uma requisição falha definitivamente."""

    def __init__(self, message: str, status_code: int | None = None) -> None:
        super().__init__(message)
        self.message = message
        self.status_code = status_code


class ClienteResiliente:
    """Cliente HTTP com suporte a retry, exponential backoff e timeout."""

    STATUS_RETENTAVEIS = {429, 500, 502, 503, 504}

    def __init__(
        self,
        servidor: FakeApiServer,
        max_tentativas: int = 3,
        backoff_base: float = 0.05,
        backoff_fator: float = 2.0,
        timeout: float = 2.0,
        sleep_fn: Callable[[float], None] = time.sleep,
    ) -> None:
        if type(max_tentativas) is not int or max_tentativas < 1:
            raise ValueError("max_tentativas deve ser um inteiro maior ou igual a 1.")

        for nome_param, val in [("backoff_base", backoff_base), ("backoff_fator", backoff_fator), ("timeout", timeout)]:
            if type(val) is bool or type(val) not in (int, float) or val <= 0:
                raise ValueError(f"{nome_param} deve ser numérico maior que zero.")

        self.servidor = servidor
        self.max_tentativas = max_tentativas
        self.backoff_base = float(backoff_base)
        self.backoff_fator = float(backoff_fator)
        self.timeout = float(timeout)
        self.sleep_fn = sleep_fn

    def get(self, rota: str) -> dict:
        return self.executar("GET", rota)

    def post(self, rota: str, payload: dict) -> dict:
        return self.executar("POST", rota, payload)

    def executar(self, metodo: str, rota: str, payload: dict | None = None) -> dict:
        for tentativa in range(1, self.max_tentativas + 1):
            try:
                resposta: ApiResponse = self.servidor.requisicao(
                    metodo=metodo,
                    rota=rota,
                    payload=payload,
                    timeout=self.timeout,
                )

                # Sucesso 2xx
                if 200 <= resposta.status_code < 300:
                    return resposta.data

                # Falhas de servidor ou rate limit que justificam retry
                if resposta.status_code in self.STATUS_RETENTAVEIS:
                    if tentativa < self.max_tentativas:
                        delay = self.backoff_base * (self.backoff_fator ** (tentativa - 1))
                        self.sleep_fn(delay)
                        continue
                    raise ApiError(
                        f"Falha na API com status {resposta.status_code}: {resposta.data}",
                        status_code=resposta.status_code,
                    )

                # Erros não recuperáveis (4xx exceto 429, 3xx, etc.) -> falha imediata sem retry
                raise ApiError(
                    f"Erro de requisição com status {resposta.status_code}: {resposta.data}",
                    status_code=resposta.status_code,
                )

            except (SimulatedNetworkError, SimulatedTimeoutError) as exc:
                if tentativa < self.max_tentativas:
                    delay = self.backoff_base * (self.backoff_fator ** (tentativa - 1))
                    self.sleep_fn(delay)
                    continue

                raise ApiError(
                    f"Tentativas esgotadas ({self.max_tentativas}) devido a erro de rede/timeout: {exc}",
                    status_code=None,
                ) from exc

        raise ApiError("Tentativas esgotadas sem resposta válida.", status_code=None)
from .bus import EventBus
