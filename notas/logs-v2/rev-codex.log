from collections import defaultdict
from typing import Callable, Union
import uuid

from .handlers import DeadLetterQueue, EventHandler
from .models import Event, Priority

HandlerType = Union[EventHandler, Callable[[Event], None]]


class EventBus:
    def __init__(self, dlq: DeadLetterQueue | None = None) -> None:
        self.dlq = dlq
        self._subscribers: dict[str, list[HandlerType]] = defaultdict(list)
        self._queue: list[Event] = []
        self._history: list[Event] = []

    def subscribe(self, topic: str, handler: HandlerType) -> None:
        if handler not in self._subscribers[topic]:
            self._subscribers[topic].append(handler)

    def unsubscribe(self, topic: str, handler: HandlerType) -> None:
        if topic in self._subscribers and handler in self._subscribers[topic]:
            self._subscribers[topic].remove(handler)

    def publish(
        self, topic: str, payload: dict, priority: Priority = Priority.NORMAL
    ) -> Event:
        event_id = f"evt_{uuid.uuid4().hex[:8]}"
        event = Event(id=event_id, topic=topic, payload=payload, priority=priority)
        self._queue.append(event)
        self._history.append(event)
        return event

    def dispatch_next(self) -> bool:
        if not self._queue:
            return False

        # Ordena para pegar maior prioridade (HIGH > NORMAL > LOW) e menor timestamp (FIFO)
        # Priority HIGH = 3, NORMAL = 2, LOW = 1
        self._queue.sort(key=lambda ev: (-int(ev.priority), ev.timestamp))
        event = self._queue.pop(0)

        handlers = list(self._subscribers.get(event.topic, []))
        for handler in handlers:
            try:
                if isinstance(handler, EventHandler):
                    handler.handle(event)
                else:
                    handler(event)
            except Exception as exc:
                if self.dlq is not None:
                    self.dlq.add(event, str(exc))
                else:
                    raise

        return True

    def dispatch_all(self) -> int:
        count = 0
        while self.dispatch_next():
            count += 1
        return count

    def get_history(self, topic: str | None = None) -> list[Event]:
        if topic is None:
            return list(self._history)
        return [ev for ev in self._history if ev.topic == topic]
from abc import ABC, abstractmethod
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from .models import Event


class EventHandler(ABC):
    @abstractmethod
    def handle(self, event: "Event") -> None:
        """Processa o evento recebido."""
        pass


class DeadLetterQueue:
    """Fila de armazenamento para eventos que falharam durante o processamento."""

    def __init__(self) -> None:
        self._failed: list[tuple["Event", str]] = []

    def add(self, event: "Event", error: str) -> None:
        self._failed.append((event, str(error)))

    def get_failed_events(self) -> list[tuple["Event", str]]:
        return list(self._failed)

    def clear(self) -> None:
        self._failed.clear()
from dataclasses import dataclass, field
from enum import IntEnum
import time


class Priority(IntEnum):
    LOW = 1
    NORMAL = 2
    HIGH = 3


@dataclass
class Event:
    id: str
    topic: str
    payload: dict
    priority: Priority = Priority.NORMAL
    timestamp: float = field(default_factory=time.time)
    retry_count: int = 0
# Premissas e Suposições de Projeto

Este documento detalha as decisões de engenharia e suposições adotadas para os pontos abertos da especificação de classificação de clientes.

## 1. Faixas e Nomes de Categorias
Como os critérios de corte e os nomes de categoria não foram estipulados no enunciado, definimos três faixas intuitivas baseadas no score final calculado:
- **Ouro**: `score >= 100.0`
- **Prata**: `50.0 <= score < 100.0`
- **Bronze**: `score < 50.0`

## 2. Tratamento de Compras com Valores Negativos
Assumimos que entradas com valores negativos na lista `compras` representam estornos ou devoluções de mercadorias. Por conseguinte, tais valores são somados algebricamente (diminuindo o montante total de compras do cliente). Caso o somatório resulte negativo, ele é ponderado normalmente pelo fator de 10%.

## 3. Tratamento de Anos Ativos Negativos ou Inválidos
Por coerência temporal, um cliente não pode possuir tempo negativo de atividade na plataforma. Valores negativos informados em `anos_ativo` são normalizados para `0` (zero) anos de atividade, evitando penalização indevida de score de fidelidade.

## 4. Campos Adicionais no Dicionário de Entrada
Campos opcionais ou não especificados presentes no payload de entrada (como e-mail, telefone, endereço) são ignorados na geração do objeto de saída, preservando apenas as chaves explicitamente requeridas (`id`, `nome`, `score`, `categoria`).
def classificar_cliente(dados: dict) -> dict:
    """Calcula o score e determina a categoria do cliente."""
    cliente_id = dados["id"]
    nome = dados["nome"]
    compras = dados.get("compras", [])
    anos_ativo = int(dados.get("anos_ativo", 0))

    # Conforme premissa em SUPOSICOES.md: anos negativos são normalizados para 0
    anos_ativo = max(0, anos_ativo)

    # Conforme premissa em SUPOSICOES.md: valores negativos em compras são tratados
    # como devoluções e subtraídos da soma
    total_compras = sum(float(v) for v in compras)
    score_compras = total_compras * 0.1
    score_fidelidade = anos_ativo * 5.0
    score_total = round(score_compras + score_fidelidade, 2)

    # Faixas de categoria definidas em SUPOSICOES.md:
    if score_total >= 100.0:
        categoria = "Ouro"
    elif score_total >= 50.0:
        categoria = "Prata"
    else:
        categoria = "Bronze"

    return {
        "id": cliente_id,
        "nome": nome,
        "score": score_total,
        "categoria": categoria,
    }
