/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import ast
import os
import shutil
import subprocess
import sys
import tempfile
import yaml

raiz = Path('tarefas').resolve()
for pasta in sorted(raiz.glob('*-gemini')):
    meta = yaml.safe_load((pasta / 'meta.yaml').read_text())
    assert meta['revisor'] == 'codex' and isinstance(meta['revisao'], str)
    testes = sum(1 for arq in (pasta / 'testes_ocultos').glob('test_*.py')
                 for node in ast.walk(ast.parse(arq.read_text()))
                 if isinstance(node, ast.FunctionDef) and node.name.startswith('test_'))
    assert testes >= 8, (pasta.name, testes)
    print(f'{pasta.name}: {testes} funções de teste; metadados OK', flush=True)

class MensagensLivres(ast.NodeTransformer):
    def visit_Call(self, node):
        self.generic_visit(node)
        if (isinstance(node.func, ast.Attribute) and node.func.attr == 'append'
                and isinstance(node.func.value, ast.Name) and node.func.value.id == 'erros'):
            node.args = [ast.Constant('Mensagem alternativa')]
        return node

def verificar(pasta, nome, preparar, ambiente=None):
    with tempfile.TemporaryDirectory() as temp:
        destino = Path(temp)
        for sub in ['inicial', 'referencia']:
            origem = pasta / sub
            if origem.exists():
                shutil.copytree(origem, destino, dirs_exist_ok=True)
        shutil.copytree(pasta / 'testes_ocultos', destino / 'testes_ocultos')
        testes = preparar(destino)
        resultado = subprocess.run([sys.executable, '-m', 'pytest', '-q', '-p', 'no:cacheprovider', testes],
                                   cwd=destino, capture_output=True, text=True, encoding='utf-8',
                                   env=ambiente, timeout=60)
        assert resultado.returncode == 0, resultado.stdout + resultado.stderr
        print(f'{nome}: {resultado.stdout.strip().splitlines()[-1]}', flush=True)

def alterar_mensagens(destino):
    arquivo = destino / 'validador.py'
    arvore = ast.fix_missing_locations(MensagensLivres().visit(ast.parse(arquivo.read_text())))
    texto = ast.unparse(arvore).replace('return (valida, erros)', 'return (valida, list(reversed(erros)))')
    arquivo.write_text(texto)
    return 'tests'

def documentacao_curta(destino):
    (destino / 'SUPOSICOES.md').write_text('X')
    return 'testes_ocultos'

verificar(raiz / '08-testes-gemini', '08 aceita mensagens e ordem alternativas', alterar_mensagens)
verificar(raiz / '10-ambigua-gemini', '10 sem mínimo de tamanho na documentação', documentacao_curta)
ambiente = dict(os.environ, LC_ALL='C', PYTHONUTF8='0', PYTHONCOERCECLOCALE='0', PYTHONIOENCODING='utf-8')
verificar(raiz / '05-cli-gemini', '05 sob locale C', lambda destino: 'testes_ocultos', ambiente)
verificar(raiz / '08-testes-gemini', '08 sob locale C', lambda destino: 'testes_ocultos', ambiente)
