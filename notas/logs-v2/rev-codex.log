import json
from pathlib import Path
import subprocess
import sys
import pytest

CLI_PATH = str(Path(__file__).resolve().parent.parent / "contatexto.py")


def run_cli(*args):
    cmd = [sys.executable, CLI_PATH, *args]
    return subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", timeout=10)


